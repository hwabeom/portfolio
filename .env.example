# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 Git에 올라가지 않는다.

# 서버 포트 (호스팅이 PORT 를 넣어 주면 그 값을 쓴다)
PORT=3000
# 배포할 때는 production 으로 둔다 (쿠키 Secure, HSTS 적용, 아래 두 값 필수)
NODE_ENV=development

# 블로그 관리자 비밀번호
ADMIN_PASSWORD=
# 관리자 세션 쿠키 서명 키 (32자 이상). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite DB 파일을 저장할 폴더
DATA_DIR=data

# 연락 폼 알림 메일 (비우면 메일 없이 DB에만 저장)
# Gmail: 2단계 인증을 켠 뒤 https://myaccount.google.com/apppasswords 에서 앱 비밀번호를 만들어 SMTP_PASS 에 넣는다
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=yeda0311@gmail.com
# 보내는 사람 주소 (비우면 SMTP_USER)
MAIL_FROM=
